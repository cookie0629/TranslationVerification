positive(x: int) => x > 0

pair(x: int) returns a: int, b: int {
  a = x;
  b = x + 1;
}

main(input: int[]) requires length(input) > 0 returns result: int uses x, y: int, copy: int[] {
  x, y = pair(input[0]);
  copy = input;
  copy[0] = y;
  result = copy[0] + x;
  if (result > 0) assert positive(result);
  while (x < y) invariant x <= y { x = x + 1; }
}
